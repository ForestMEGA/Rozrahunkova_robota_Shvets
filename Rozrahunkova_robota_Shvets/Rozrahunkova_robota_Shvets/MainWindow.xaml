<Window x:Class="Rozrahunkova_robota_Shvets.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Rozrahunkova_robota_Shvets"
        mc:Ignorable="d"
        Title="Розрахункова робота" Height="420" Width="520" MinHeight="420" MinWidth="520">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Введіть число:" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="14"/>
            <TextBox x:Name="InputTextBox" Width="120" Height="25" VerticalContentAlignment="Center" FontSize="14"/>
            <Button Content="Додати (Enqueue)" Width="130" Height="25" Margin="10,0,0,0" Click="EnqueueButton_Click" Background="#E1F5FE"/>
            <Button Content="Видалити (Dequeue)" Width="130" Height="25" Margin="10,0,0,0" Click="DequeueButton_Click" Background="#FFEBEE"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Перший в черзі (Peek): " FontWeight="Bold" FontSize="14"/>
            <TextBlock x:Name="PeekTextBlock" Text="немає" Margin="5,0,20,0" FontSize="14" Foreground="Blue"/>

            <TextBlock Text="Всього елементів: " FontWeight="Bold" FontSize="14"/>
            <TextBlock x:Name="CountTextBlock" Text="0" Margin="5,0,0,0" FontSize="14"/>
        </StackPanel>

        <GroupBox Grid.Row="2" Header="Поточний стан черги" FontSize="12">
            <StackPanel Margin="10">
                <TextBlock Text="Прямий порядок (head -> tail):" Margin="0,5,0,5" FontWeight="SemiBold"/>
                <TextBox x:Name="QueueDisplayTextBox" IsReadOnly="True" Height="40" VerticalContentAlignment="Center" FontSize="14" Background="#F5F5F5" TextWrapping="Wrap"/>

                <TextBlock Text="Зворотний порядок (tail -> head):" Margin="0,15,0,5" FontWeight="SemiBold"/>
                <TextBox x:Name="QueueReverseDisplayTextBox" IsReadOnly="True" Height="40" VerticalContentAlignment="Center" FontSize="14" Background="#F5F5F5" TextWrapping="Wrap"/>
            </StackPanel>
        </GroupBox>

        <Border Grid.Row="3" Background="#E8F5E9" CornerRadius="5" Padding="10" Margin="0,15,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Кількість від'ємних елементів: " FontSize="16" FontWeight="Bold" Foreground="#2E7D32"/>
                <TextBlock x:Name="NegativeCountTextBlock" Text="0" FontSize="16" FontWeight="Bold" Foreground="#2E7D32"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
